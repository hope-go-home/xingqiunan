# 运行环境：dev / prod（prod 下未设置 SECRET_KEY 会拒绝启动）
ENV=dev

# 数据库
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_workbench
# Redis（Celery 队列 + 会话上下文缓存）
REDIS_URL=redis://:123456@localhost:6380/0

# JWT（生产环境必须替换为随机长字符串）
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 白名单（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173

# LLM
DASHSCOPE_API_KEY=sk-your-dashscope-key
LLM_MODEL=qwen3.7-plus

# 高德地图（天气工具，经 MCP Server 提供）
AMAP_API_KEY=

# 博查（联网搜索工具，https://open.bochaai.com 申请）
BOCHA_API_KEY=sk-your-bocha-key

# 成本熔断：每用户每日费用预算（元），超限拒绝新的 Agent 请求并在执行中自动终止
COST_DAILY_BUDGET=10

# 工作区（Agent 可读写的根目录，本机运行时指向本地绝对路径）
WORKSPACE_DIR=./workspace

# 本地数据目录
CHROMA_PERSIST_DIR=./chroma_data
UPLOAD_DIR=./uploads
